# --- Required ---
# GitHub OAuth App (Settings > Developer settings > OAuth Apps). Callback URL: <your-url>/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 64 hex characters, encrypts the GitHub tokens stored in the database. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Access control (strongly recommended) ---
# Only members of this GitHub organization can sign in.
ALLOWED_ORG=
# Comma-separated GitHub logins always allowed (in addition to ALLOWED_ORG).
ALLOWED_LOGINS=

# --- Optional ---
# Token used for scheduled rescans (fine-grained PAT with "Contents: read" on the organization repositories).
# Without it, rescans reuse the token of the user who last scanned each repository.
GITHUB_TOKEN=
# Rescan every known repository automatically (0 = disabled).
RESCAN_INTERVAL_HOURS=24
PORT=3000
# Where the SQLite database lives (default: ./data)
DATA_DIR=
# Set to "true" behind a reverse proxy (or to the number of trusted hops).
TRUST_PROXY=
# Force the Secure cookie flag outside NODE_ENV=production
SECURE_COOKIES=
DEBUG=false
